<?xml version="1.0" encoding="utf-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
            id="loevgaard_sylius_brand.twig.component.brand.form"
            class="Loevgaard\SyliusBrandPlugin\Twig\Component\Brand\FormComponent"
        >
            <argument type="service" id="loevgaard_sylius_brand.repository.brand" />
            <argument type="service" id="form.factory" />
            <argument>%loevgaard_sylius_brand.model.brand.class%</argument>
            <argument>Loevgaard\SyliusBrandPlugin\Form\Type\BrandType</argument>

            <call method="setLiveResponder">
                <argument type="service" id="ux.live_component.live_responder"/>
            </call>

            <tag name="sylius.live_component.admin" key="loevgaard_sylius_brand:brand:form" />
        </service>
    </services>
</container>
